# App
APP_NAME=Insider Threat Behavioral Intelligence System
ENV=development

# Database
POSTGRES_USER=itbis_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=itbis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://itbis_user:changeme@localhost:5433/itbis_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth (create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials -> Create Credentials ->
# OAuth client ID -> Web application. Add the redirect URI below to the
# authorized redirect URIs. Put the real values in .env, not here — this
# file is tracked by git and your secret would be committed.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173